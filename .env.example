# Public Convex client endpoint for the environment being run.
NEXT_PUBLIC_CONVEX_URL=
# Convex deployment selector (for example, dev:your-development-deployment).
CONVEX_DEPLOYMENT=

# Server-only keys are configured in local .env.*.local files and Vercel.
CLERK_SECRET_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=

# Never place secrets in NEXT_PUBLIC_* variables. See docs/COST_EFFICIENCY.md.
